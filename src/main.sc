# Объявление темы по умолчанию, которая обрабатывает любые входящие сообщения пользователя
theme: /

    # ---------------------- СЦЕНАРИЙ №1: ГОРЯЧАЯ ЛИНИЯ ----------------------
    # Состояние отслеживает запросы номера поддержки
    state: HotlineRequest
        # Список фраз, на которые сработает интент
        intent!: /телефон горячей линии
        intent!: /как связаться с банком
        intent!: /горячая линия
        intent!: /номер поддержки
        intent!: /позвонить в банк

        # Начальное состояние: предлагаем помощь в чате
        state: SuggestChatHelp
            a: Конечно, телефон службы поддержки есть.
            a: Но, возможно, я смогу помочь вам быстрее, так как многие вопросы можно решить прямо в чате. Что именно вас интересует?
            # Переход в состояние ожидания повторного запроса номера. Используем fallback, чтобы поймать любую следующую реплику.
            go: WaitForRepeat

        # Состояние ожидания: если пользователь снова просит номер
        state: WaitForRepeat
            # Снова ловим тот же самый интент (повторный запрос)
            intent!: /телефон горячей линии
            intent!: /как связаться с банком
            intent!: /горячая линия
            intent!: /номер поддержки
            intent!: /позвонить в банк
            # Если пользователь согласился (обрабатываем слова "да")
            from: @yes

            # Предлагаем перевод на оператора
            a: Я могу перевести вас на оператора для решения вопроса в чате, устроит?
            # Кнопки для выбора
            buttons:
                "Да, переведите"
                "Нет, нужен телефон"
            # Переходим в состояние выбора
            go: HandleTransferChoice

        # Состояние обработки выбора пользователя
        state: HandleTransferChoice
            # Если выбор пал на "Да" или слова согласия
            if: (@yes && @lastState == "HandleTransferChoice") || ({{$dialog.buttonsHit.button}} && "Да" in {{$dialog.buttonsHit.button}})
                # Перевод на оператора. В JAICP это делается через переход в служебное состояние.
                a: Соединяю с оператором. Пожалуйста, подождите.
                # Служебный переход на живого оператора (требует настройки в разделе Channels)
                go: /TransferToOperator

            # Если выбор пал на "Нет"
            else:
                # Предоставляем номер телефона
                a: Номер поддержки 8 (495) 981-0-981 работает 24/7.
                a: Звонок платный, стоимость зависит от тарифов вашего оператора связи.
                # Завершаем сценарий и переходим к опросу "Остались ли вопросы?"
                go: /CloseDialog

    # ---------------------- СЦЕНАРИЙ №2: СПОСОБЫ ОПЛАТЫ ----------------------
    state: PaymentMethods
        # Срабатывает на вопросы об оплате
        intent!: /как оплатить
        intent!: /способы оплаты
        intent!: /оплатить кредит
        intent!: /где внести наличные
        intent!: /как пополнить

        # Запрашиваем уточнение у пользователя
        a: Выберите, что вас интересует:
        buttons:
            "Как пополнить в приложении?"
            "Где внести наличные?"
            "Сложности с оплатой"

        # Переходим в состояние обработки выбора
        go: ProcessPaymentChoice

        # Состояние выбора
        state: ProcessPaymentChoice
            # Вариант 1: Приложение
            if: (@yes && @lastState == "ProcessPaymentChoice") || ({{$dialog.buttonsHit.button}} && "приложен" in {{$dialog.buttonsHit.button}})
                a: Для пополнения продукта перейдите в него и выберите «Пополнить».
                a: 💰 ознакомиться с комиссией можно при оплате.
                go: /CloseDialog

            # Вариант 2: Наличные
            elif: ({{$dialog.buttonsHit.button}} && "наличн" in {{$dialog.buttonsHit.button}}) || (@lastState == "ProcessPaymentChoice" && "наличные" in {{$request.query}})
                a: Внести наличные можно:
                a: - в офисе нашего банка (банкомат/терминал/касса);
                a: - в банкоматах: «ВТБ», «Альфа-Банка», «Райффайзенбанк».
                a: Комиссии нет, а внести можно от 500 тыс. до 1.5 млн.
                a: Подобрать удобный адрес и ознакомиться с режимом работы можно в разделе «Отделения и банкоматы» (https://rencredit.ru/addresses/).
                a: 🏛 Подробная информация о всех способах оплаты доступна на нашем сайте в разделе «Платежи и переводы» (https://rencredit.ru/payment/).
                go: /CloseDialog

            # Вариант 3: Сложности с оплатой -> Перевод на оператора
            else:
                a: Вас понял, уже перевожу.
                go: /TransferToOperator


    # ---------------------- ЗАВЕРШЕНИЕ ДИАЛОГА (ОБЩИЙ ДЛЯ ВСЕХ СЦЕНАРИЕВ) ----------------------
    # Служебное состояние, которое вызывается из других сценариев для завершения диалога
    state: CloseDialog
        # Вопрос о дальнейших потребностях
        a: Я ответил на ваш вопрос? Осталось ли что-то, чем я могу помочь?
        buttons:
            "Да, спасибо, все хорошо"
            "Нет, остался вопрос"
            "Показать список моих возможностей"

        # Обработка ответа
        state: FinalChoice
            # Если пользователь закончил
            if: (@yes && @lastState == "FinalChoice") || ({{$dialog.buttonsHit.button}} && "спасибо" in {{$dialog.buttonsHit.button}} || "хорошо" in {{$dialog.buttonsHit.button}})
                a: Рад был помочь! Всегда обращайтесь. Хорошего дня!
                # Завершаем сессию. В JAICP это останавливает выполнение сценария.
                go: /Exit

            # Если пользователь хочет вернуться в главное меню
            elif: ({{$dialog.buttonsHit.button}} && "возможностей" in {{$dialog.buttonsHit.button}})
                a: Вот что я умею:
                a: - Спросить номер горячей линии
                a: - Рассказать, как оплатить кредит или внести наличные
                a: - Подсказать адрес отделения
                go: /

            # Если хочет задать еще один конкретный вопрос (действуем через fallback)
            else:
                a: Давайте попробуем еще раз. Задайте ваш вопрос, и я постараюсь помочь.
                # Возвращаем бота в начало темы, чтобы он снова обработал интент пользователя
                go: /


    # ---------------------- ОБРАБОТЧИК FALLBACK (Если бот ничего не понял) ----------------------
    # Это стандартная практика для любого бота на JAICP
    state: Fallback
        # Срабатывает, если ни один интент не подошел
        event!: noMatch

        a: Извините, я вас не совсем понял. Я бот-ассистент банка и могу помочь с номерами телефонов, способами оплаты и адресами отделений.
        a: Попробуйте перефразировать ваш вопрос или воспользоваться кнопками.

        # После непонимания всё равно предлагаем помощь
        go: /CloseDialog


    # ---------------------- СЛУЖЕБНЫЙ ПЕРЕВОД НА ОПЕРАТОРА ----------------------
    # Для работы этого состояния необходимо в разделе Settings -> Channels настроить канал с операторами
    state: TransferToOperator
        # Служебное событие JAICP для эскалации живому оператору
        event!: transferToOperator
        # Текст, который увидит пользователь перед началом чата с человеком
        a: Пожалуйста, подождите, я соединяю вас с оператором чата.
