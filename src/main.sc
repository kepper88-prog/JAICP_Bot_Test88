theme: /

    # ---------------------- СЦЕНАРИЙ 1: НОМЕР ГОРЯЧЕЙ ЛИНИИ ----------------------
    
    # Первый запрос телефона
    state: PhoneFirst
        q: * номер телефона *
        q: * телефон *
        q: * горячая линия *
        q: * номер поддержки *
        q: * как связаться с банком *
        q: * позвонить в банк *
        
        script:
            var asked = $session.phoneAsked;
            if (!asked) {
                $session.phoneAsked = true;
                $reactions.answer("Конечно, телефон службы поддержки есть.\n\nНо, возможно, я смогу помочь вам быстрее, так как многие вопросы можно решить прямо в чате. Что именно вас интересует?");
                $reactions.transition("/");
            } else {
                $session.phoneAsked = false;
                $reactions.answer("Я могу перевести вас на оператора для решения вопроса в чате. Вас это устроит?\n\n✅ Да, переведите\n❌ Нет, нужен телефон");
                $reactions.transition("/PhoneWaitButtons");
            }

    # Кнопки для подтверждения перевода
    state: PhoneWaitButtons
        a: Пожалуйста, выберите вариант ответа:
        buttons:
            "Да, переведите"
            "Нет, нужен телефон"

    # Обработка ответа "Нет"
    state: PhoneNo
        event: match
        q: * нет *
        q: * Нет, нужен телефон *
        
        a: Номер горячей линии поддержки: 8 (495) 981-0-981
        a: Режим работы: круглосуточно, 24/7
        a: Звонок платный, стоимость зависит от тарифов вашего оператора связи.
        go: /CloseDialog

    # Обработка ответа "Да"
    state: PhoneYes
        event: match
        q: * да *
        q: * Да, переведите *
        
        a: Соединяю с оператором. Пожалуйста, ожидайте.
        go: /TransferToOperator


    # ---------------------- СЦЕНАРИЙ 2: СПОСОБЫ ОПЛАТЫ ----------------------
    
    # Пополнение через приложение
    state: PaymentApp
        q: * как пополнить *
        q: * пополнить в приложении *
        q: * оплатить через приложение *
        
        a: Для пополнения продукта перейдите в него и выберите раздел «Пополнить».
        a: 💰 Ознакомиться с комиссией можно непосредственно при оплате.
        go: /CloseDialog

    # Внесение наличных средств
    state: PaymentCash
        q: * где внести наличные *
        q: * внести наличные *
        q: * наличные *
        q: * оплатить наличными *
        
        a: Внести наличные можно следующими способами:
        a: • в офисе нашего банка (банкомат, терминал или касса);
        a: • в банкоматах партнёров: «ВТБ», «Альфа-Банк», «Райффайзенбанк».
        a: 
        a: Комиссия отсутствует. Сумма внесения: от 500 рублей до 1,5 миллиона рублей.
        a: 
        a: Подобрать удобный адрес и ознакомиться с режимом работы можно в разделе «Отделения и банкоматы»:
        a: 🔗 https://rencredit.ru/addresses/
        a: 
        a: 🏛 Полная информация о всех способах оплаты доступна на нашем сайте в разделе «Платежи и переводы»:
        a: 🔗 https://rencredit.ru/payment/
        go: /CloseDialog

    # Сложности с оплатой
    state: PaymentProblem
        q: * сложности с оплатой *
        q: * проблемы с оплатой *
        q: * не могу оплатить *
        q: * ошибка при оплате *
        
        a: Вас понял. Соединяю с оператором для решения вашего вопроса.
        go: /TransferToOperator

    # Главное меню способов оплаты
    state: PaymentMenu
        q: * как оплатить кредит *
        q: * оплатить кредит *
        q: * способы оплаты *
        q: * какими способами оплатить *
        
        a: Пожалуйста, выберите, что именно вас интересует:
        buttons:
            "Как пополнить в приложении?"
            "Где внести наличные?"
            "Сложности с оплатой"


    # ---------------------- СЦЕНАРИЙ 3: ЗАВЕРШЕНИЕ ДИАЛОГА ----------------------
    
    state: CloseDialog
        a: Я ответил на ваш вопрос. Осталось ли что-то, чем я могу помочь?
        buttons:
            "Да, спасибо, всё хорошо"
            "Нет, остался вопрос"
            "Показать список моих возможностей"

    # Пользователь завершил диалог
    state: CloseYes
        event: match
        q: * да *
        q: * спасибо *
        q: * всё хорошо *
        
        a: Рад был помочь! Всегда обращайтесь. Хорошего дня!
        go: /Exit

    # Показать список возможностей бота
    state: CloseCapabilities
        event: match
        q: * возможности *
        q: * умеешь *
        q: * что ты умеешь *
        q: * список возможностей *
        
        a: Вот что я умею:
        a: 📞 - подсказать номер горячей линии банка;
        a: 💳 - рассказать, как оплатить кредит;
        a: 🏦 - подсказать, где внести наличные;
        a: ❓ - ответить на другие вопросы о банковских услугах.
        a: 
        a: Просто напишите мне ваш вопрос, и я постараюсь помочь!
        go: /
        script:
            $session.phoneAsked = false;

    # У пользователя остались вопросы
    state: CloseNo
        event: match
        q: * нет *
        q: * остался *
        q: * остались вопросы *
        
        a: Давайте попробуем ещё раз. Задайте ваш вопрос, и я постараюсь помочь.
        go: /
        script:
            $session.phoneAsked = false;


    # ---------------------- ОБРАБОТКА НЕРАСПОЗНАННЫХ ФРАЗ ----------------------
    
    state: Fallback
        event!: noMatch
        a: Извините, я не совсем понял ваш вопрос.
        a: Я могу помочь вам со следующими запросами:
        a: 📞 - сказать номер горячей линии банка;
        a: 💳 - рассказать, как оплатить кредит;
        a: 🏦 - подсказать, где внести наличные.
        a: Пожалуйста, переформулируйте ваш вопрос или выберите один из вариантов выше.
        go: /
        script:
            $session.phoneAsked = false;


    # ---------------------- СЛУЖЕБНЫЕ СОСТОЯНИЯ ----------------------
    
    # Перевод на оператора
    state: TransferToOperator
        event!: transferToOperator
        a: Пожалуйста, подождите. Я соединяю вас с оператором чата.

    # Завершение сессии
    state: Exit
        event!: exit
        script:
            $session.phoneAsked = false;